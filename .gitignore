# Large raw datasets (too big for Git — download separately)
# gym_members_exercise_tracking.csv is small (64KB) and IS tracked
backend/data/datasets/programs_detailed_boostcamp_kaggle.csv

# Generated exercise video files (large MP4s — regenerate with build_exercise_videos_manual.py)
backend/static/

# Generated exercise video index (regenerated by build script)
backend/data/exercise_videos.json

# ── Form-analysis pipeline (Phase A–F) — large artifacts & build outputs ─────
# Raw + preprocessed Fit3D / MediaPipe datasets (multi-GB). Rebuilt by
# backend/training/preprocessing/dataset_builder.py from fit3d_annotations.zip
# + videos.zip — see COLAB_RUNBOOK.md.
backend/data/form_dataset/
backend/data/form_dataset_mediapipe/
backend/data/mediapipe_fit3d/
fitnova_mediapipe/
fitnova_mediapipe-*.zip
videos.zip
fit3d_annotations.zip
fitnova_src.zip

# MT-TCN model backups (each ~25 MB; the active /backend/models/form_model/
# is tracked, but version-stamped backups are not)
backend/models/form_model_v*_backup_*/
backend/models/form_model_*_backup_*/

# MediaPipe pose-landmarker static asset (download from Google's CDN — see
# backend/services/form_analyzer.py for URL)
backend/models/pose_landmarker_full.task

# Reality-check / validation report outputs (regenerated by validate scripts)
backend/models/form_model/reality_check/

# Local annotated MP4s produced by visualize_pipeline.py
*_annotated.mp4
*_LOCKED.mp4
