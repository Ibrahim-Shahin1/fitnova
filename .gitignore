# Large raw datasets (too big for Git — download separately)
# gym_members_exercise_tracking.csv is small (64KB) and IS tracked
backend/data/datasets/programs_detailed_boostcamp_kaggle.csv

# Generated exercise video files (large MP4s — regenerate with build_exercise_videos_manual.py)
backend/static/

# Generated exercise video index (regenerated by build script)
backend/data/exercise_videos.json

# ── Form-analysis pipeline (Phase A–F) — large artifacts & build outputs ─────
# Raw + preprocessed Fit3D / MediaPipe datasets (multi-GB). Rebuilt by
# backend/training/preprocessing/dataset_builder.py from fit3d_annotations.zip
# + videos.zip — see COLAB_RUNBOOK.md.
backend/data/form_dataset/
backend/data/form_dataset_mediapipe/
backend/data/mediapipe_fit3d/
fitnova_mediapipe/
fitnova_mediapipe-*.zip
videos.zip
fit3d_annotations.zip
fitnova_src.zip

# MT-TCN model backups (each ~25 MB; the active /backend/models/form_model/
# is tracked, but version-stamped backups are not)
backend/models/form_model_v*_backup_*/
backend/models/form_model_*_backup_*/

# MediaPipe pose-landmarker static asset (download from Google's CDN — see
# backend/services/form_analyzer.py for URL)
backend/models/pose_landmarker_full.task

# Reality-check / validation report outputs (regenerated by validate scripts)
backend/models/form_model/reality_check/

# Local annotated MP4s produced by visualize_pipeline.py
*_annotated.mp4
*_LOCKED.mp4

# ── v6 (QEVD) — large artifacts, ignore raw + extracted, track phase reports ──
# Raw QEVD multi-part archive (~500 GB unencoded). User downloads to local
# disk; never committed.
backend/data/qevd_raw/
# MediaPipe-extracted .npz shards (~50-80 GB). Regenerated by
# backend/training/preprocessing/qevd_extractor.py — see master plan §II.4.3.
backend/data/qevd_extracted/
# NOTE: backend/data/qevd_phase_reports/ is INTENTIONALLY tracked. The D0-D9
# JSON reports are committee evidence; they are small (~few KB each) and form
# the appendix of the dissertation.

# Colab source bundles built by _build_v5*_colab_bundle.py (regeneratable)
fitnova_v*_src.zip
# Local dataset zip bundles (regeneratable)
v*_dataset.zip

# v5 / v5.1 / v5.2 pre-built datasets (40-130 MB each, regeneratable from
# Fit3D + dataset_builder_v5.py). Pre-MediaPipe extractions are also too
# large for git.
backend/data/v5_dataset/
backend/data/v5_1_dataset/
backend/data/v5_2_dataset/
backend/data/mediapipe_fit3d_v5/

# Smoke-train output dirs (dev artifacts; regeneratable on demand).
# Real model weights live in backend/models/form_model_v6/ etc. and ARE
# tracked.
backend/models/form_model_v6_smoke/
backend/models/form_model_v6_1_smoke/

# Local user test videos used by reality_check_v*.py D9. Personal data.
backend/training/diagnostics/references/input_clips/*.mp4

# Fitness-AQA official Code_Release � cloned for inspection, not tracked
Fitness-AQA-Code/

# -- Phase-5 Squat MD-SSL weights -- staged from Drive, never committed (D-09) --
# The 3 Phase-4 best.pt files (~358 MB each = ~1.07 GB total) are staged manually
# from MyDrive/FitNova/checkpoints/phase04/md_finetune_seed{42,1337,7}/best.pt.
# They live here for SquatFormService to load at runtime but are too large for git.
# The README.md is KEPT (negation below) -- it documents the staging procedure.
backend/models/form_model_squat_md/seed*/
backend/models/form_model_squat_md/**/*.pt
!backend/models/form_model_squat_md/README.md
