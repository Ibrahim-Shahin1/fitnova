# FitNova LLM Adapter - OpenAI credentials
# Copy to .env and fill in your key.
OPENAI_API_KEY=sk-your-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (auth + per-user Postgres). Get these from your Supabase project:
#   Settings → API: URL, anon key, JWT secret
#   Settings → Database: connection string (use the service-role / direct connection)
# ─────────────────────────────────────────────────────────────────────────────

# Public — also shipped to the Flutter client via --dart-define. Safe to expose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Backend-only secrets. NEVER ship to the client, NEVER commit the real .env.
# JWT secret is used to verify the HS256 signature of incoming Supabase access tokens.
SUPABASE_JWT_SECRET=your-jwt-secret
# Service-role Postgres connection string (bypasses RLS). Used by the FastAPI backend
# to write plan/log/conversation rows on the authenticated user's behalf.
# Example: postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
